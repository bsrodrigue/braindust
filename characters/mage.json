{
 "sheet": "assets/player.png",
 "atlas": "assets/player.json",
 "height": 96,
 "tint": "#dbe3e6",
 "states": {
  "idle":   { "anim": "idle", "fps": 4 },
  "drift":  { "anim": "idle", "fps": 2.5 },
  "run":    { "anim": "run", "fps": 6, "fpsParam": "runRatio", "fpsGain": 8 },
  "rise":   { "anim": "run", "frames": [1] },
  "fall":   { "anim": "run", "frames": [3] },
  "strike": { "anim": "attack", "frames": [0, 1, 4, 5], "drive": "strike", "driveLength": 0.36 },
  "flare":  { "anim": "attack", "frames": [3] },
  "cast":   { "anim": "attack", "frames": [2, 3], "drive": "castHold", "driveLength": 0.36 }
 },
 "transitions": [
  { "from": "any", "to": "strike", "when": ["strike > 0"] },
  { "from": "any", "to": "flare",  "when": ["flare"] },
  { "from": "any", "to": "cast",   "when": ["castHold > 0"] },
  { "from": "any", "to": "rise",   "when": ["!inWater", "!ground", "vy < 0"] },
  { "from": "any", "to": "fall",   "when": ["!inWater", "!ground"] },
  { "from": "any", "to": "run",    "when": ["!inWater", "speed > 30"] },
  { "from": "any", "to": "drift",  "when": ["inWater"] },
  { "from": "any", "to": "idle" }
 ]
}
